# Application Configuration
PORT=3000
NODE_ENV=development

# Security & Session Secrets
SESSION_SECRET=change-this-super-secret-key-in-production-1234567890

# Database Configuration
DB_FILE=hospital.db

# Administrator account (seeded automatically if it does not exist)
DEMO_ADMIN_EMAIL=admin@hospital.local
DEMO_ADMIN_PASSWORD=replace-with-a-strong-unique-password
